{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time To Lock In",
  "version": "0.1.12",
  "identifier": "com.timetolockin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Time To Lock In",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      },
      {
        "title": "TTLI",
        "label": "mini",
        "width": 300,
        "height": 228,
        "minWidth": 300,
        "minHeight": 228,
        "maxWidth": 300,
        "maxHeight": 228,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/reconix37/time-to-lock-in/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRjJEMkIyQzM2OUIxRDMKUldUVHNXbkRzdEx5ZXVZRS9ZdkYzQkwyVDM4Zng3QjltYnU5TDRJczJocjFxR0EybGlpaEQrZEMK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
